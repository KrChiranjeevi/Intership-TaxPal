# ==============================================
# TaxPal Server Environment Variables Template
# Copy this file to .env and configure your values
# ==============================================

# Environment Mode (development | production)
NODE_ENV="development"

# Database connection (PostgreSQL via Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/taxpal_db?schema=public"

# Server Port
PORT=5000

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN="http://localhost:4200"
FRONTEND_URL="http://localhost:4200"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Security / Hashing
BCRYPT_SALT_ROUNDS=10

# Password Reset Token Expiry (in minutes)
PASSWORD_RESET_EXPIRES_MINUTES=15

# AI Expense Categorization (Google Gemini API Key)
AI_API_KEY="your-google-gemini-api-key-here"

# SMTP Email Service (Nodemailer for Reminders & Alerts)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="TaxPal <noreply@taxpal.com>"
